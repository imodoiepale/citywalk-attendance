# ── Where scans go ───────────────────────────────────────────────────────────
# destinations.yaml is the real answer: any number of independent destinations,
# each with its own durable queue, so a third-party webhook cannot delay a punch
# reaching Supabase. Copy destinations.example.yaml to get started.
DESTINATIONS_FILE=destinations.yaml

# Fallback when destinations.yaml is absent — a single destination, exactly as
# the gateway behaved before fan-out existed.
# supabase = write straight to the database. Attendance keeps working even when
#            the web app is down, mid-deploy or cold-starting. This is the live
#            path and the default.
# app      = post to the app's HMAC-signed webhook instead. Slower to react, but
#            keeps the service-role key off this host — the right choice for a
#            gateway on a branch mini-PC rather than your own VPS.
SINK=supabase

# ── Third-party destination secrets ─────────────────────────────────────────
# destinations.yaml never holds a secret; it names the variable holding one via
# auth.secretEnv. Define those variables here. Boot fails, with the variable's
# name, if a destination references one that is unset.
# N8N_WEBHOOK_SECRET=
# PARTNER_HRMS_TOKEN=
# OVERTIME_BOT_KEY=

# ── SINK=supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=https://kntejfukhzgccmqtioag.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses RLS, so treat it like a
# root password: never in git, never in devices.yaml, never pasted in chat.
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── SINK=app ─────────────────────────────────────────────────────────────────
# APP_URL=https://your-app.example.com
# Must be byte-identical to BIOMETRIC_WEBHOOK_SECRET in the Next.js app.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BIOMETRIC_WEBHOOK_SECRET=

# ── Where devices connect ────────────────────────────────────────────────────
# HTTP and WebSocket share this port.
GATEWAY_HTTP_PORT=8080

# Extra raw-TCP listeners, for firmware that dials a socket instead of speaking
# HTTP. Comma separated; empty to disable. Only open a port you have actually
# seen a device connect to.
#
# 5005 is the FkWeb port: the EN-K190FTW and its FK-family relatives open a TCP
# connection here, send one JSON scan, and wait for the gateway's JSON reply.
# A device configured as vendor: fkweb with no listener on its port will buffer
# silently — the gateway warns at boot if that combination is detected.
GATEWAY_TCP_PORTS=5005

# ── The cloud channel: two-way device management ─────────────────────────────
# Terminals in cloud/ADMS mode dial this port and STAY connected, so commands
# can go back down the same socket. That is what makes remote enrolment,
# credential replication and log backfill possible without a Windows PC or a
# VPN at the branch. Set to 0 to disable.
#
# Accepts both WebSocket and raw JSON over TCP on the same port, because the
# vendor software runs both there and firmware varies.
GATEWAY_CLOUD_PORT=7788

# ── M50 WebSocket terminals ──────────────────────────────────────────────────
# The M50 family (M82 and relatives) reaches the gateway over the ordinary
# WebSocket listener on GATEWAY_HTTP_PORT, at whatever `ws://` or `wss://`
# address is set as the terminal's "Web Server URL" in its Communication menu.
# There is no separate port to open.
#
# Those terminals must complete a Register -> Login handshake before they will
# send a single scan, and the token they are issued is derived from this secret.
# Keeping it set means a device stays registered across gateway restarts; leave
# it empty and tokens become per-process, so every restart makes the estate
# re-register (harmless, but noisy and briefly lossy).
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
M50_TOKEN_SECRET=

# How often to look for queued device commands. The app writes rows to
# device_commands; this is the latency an operator sees after clicking.
COMMAND_POLL_MS=2000

# ── Biometric template encryption ────────────────────────────────────────────
# REQUIRED to store credentials. Templates are sealed with AES-256-GCM here,
# before they reach Postgres, so a database dump is ciphertext and no database
# role can decrypt one. Without this the gateway refuses to store a captured
# credential rather than writing biometric data in the clear.
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Treat it like the service-role key: VPS environment only, never in git. Lose
# it and every stored credential becomes unreadable — the estate would have to
# be re-enrolled.
BIOMETRIC_TEMPLATE_KEY=

# Comma-separated keys retired by a rotation. Still used for DECRYPTION, so
# existing credentials keep working while they are re-sealed in the background.
BIOMETRIC_TEMPLATE_KEYS_PREVIOUS=

# ── Behaviour ────────────────────────────────────────────────────────────────
DEVICES_FILE=devices.yaml
SPOOL_DIR=spool
TZ=Africa/Nairobi
LOG_LEVEL=info

# Reject pushes from serials not listed in devices.yaml. The firmware cannot
# sign its requests, so this allowlist is the only authentication the push
# endpoint has. Set false ONLY on a LAN while capturing an unknown device.
STRICT_SERIALS=true

# Store a verbatim copy of every payload — parsed or not — in
# device_raw_payloads. The ones we cannot parse are the most valuable to keep.
ARCHIVE_RAW=true

# ── Public address handled by Caddy ─────────────────────────────────────────
# Initial raw-IP capture (HTTP):
GATEWAY_ADDRESS=:80
# With DNS and HTTPS support on the sender, use just the hostname instead:
# GATEWAY_ADDRESS=biometric.example.co.ke
# If the terminal accepts a hostname but only speaks HTTP:
# GATEWAY_ADDRESS=http://biometric.example.co.ke

# ── Optional Cams Web API v3 callback ────────────────────────────────────────
# Leave empty when using the terminal's native FkWeb push. If you activate the
# paid Cams Protocol Engine, copy the AuthToken from its API Monitor and set its
# Callback URL to https://YOUR_DOMAIN/callbacks/cams.
CAMS_AUTH_TOKEN=
# Comma-separated additional tokens when several Cams service tags share this
# callback. CAMS_AUTH_TOKEN above remains accepted too.
CAMS_AUTH_TOKENS=
# Optional; must be exactly 32 UTF-8 bytes and match the API Monitor Security
# Key. The gateway then decrypts AES-256-ECB/PKCS padding callbacks.
CAMS_SECURITY_KEY=
