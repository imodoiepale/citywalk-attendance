# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by signed biometric ingest routes and out-of-band admin scripts.
# It must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Biometric ingest -------------------------------------------------------
# Ingest is the only surface that accepts writes without a user session, so
# these are what stand in front of it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signs JSON webhook payloads (HMAC-SHA256 over the raw body). Unset means the
# webhook refuses everything, which is the intended failure mode.
BIOMETRIC_WEBHOOK_SECRET=

# Shared token for ZKTeco push devices, which cannot sign a request body. Sent
# as ?token= on the /api/biometric/iclock endpoint.
BIOMETRIC_PUSH_TOKEN=

# Canonical public origin used for password-recovery and invite emails.
# Must exactly match a URL in the Supabase auth redirect allow list.
NEXT_PUBLIC_SITE_URL=https://citywalk-attendance.vercel.app
